{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "jsxImportSource": "preact", "strict": true, "noImplicitAny": false,
    "skipLibCheck": true, "resolveJsonModule": true, "esModuleInterop": true, "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "scripts"]
}
